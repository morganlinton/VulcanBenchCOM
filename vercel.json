{
  "redirects": [
    {
      "source": "/benchmark-your-stack.html",
      "destination": "/eval-suite-builder.html",
      "permanent": true
    },
    {
      "source": "/analysis.html",
      "destination": "/benchmarks.html",
      "permanent": true
    },
    {
      "source": "/analysis/01-muse-wonder-full-vs-gpt-6-1-sol.html",
      "destination": "/benchmarks/swe-v4-musewonder-full-vs-gpt61-sol-traces.html",
      "permanent": true
    },
    {
      "source": "/analysis/02-muse-wonder-full-combined-time-cost.html",
      "destination": "/benchmarks/swe-v4-musewonder-full-vs-frontier.html",
      "permanent": true
    },
    {
      "source": "/build-offs/play/fall-line/:path*",
      "destination": "/build-offs/play/tahoe-ski-adventures/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
